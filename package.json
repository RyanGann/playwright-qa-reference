{
  "name": "playwright-qa-reference",
  "version": "1.0.0",
  "private": true,
  "description": "Reference Playwright end-to-end suite — page objects, typed fixtures, CI integration, and measured stability.",
  "author": "Ryan Gann",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed --project=chromium",
    "test:debug": "playwright test --debug --project=chromium",
    "report": "playwright show-report",
    "flake-check": "bash scripts/flake-check.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
